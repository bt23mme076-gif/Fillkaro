{
  "manifest_version": 3,
  "name": "FillKaro – One-Click Form Filler",
  "short_name": "FillKaro",
  "version": "1.1.0",
  "description": "Save your details once, fill placement forms, Google Forms & applications in one click. Learns your answers. Data stays local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FillKaro — Alt+Shift+F to fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Fill the form on this page"
    }
  }
}
